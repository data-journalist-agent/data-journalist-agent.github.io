{
  "meta": {
    "role": "designer",
    "version": "2.0",
    "palette": {
      "primary": "#2A6F62",
      "primary_dark": "#1F4F46",
      "accent_warm": "#D9844B",
      "accent_red": "#B94B45",
      "accent_blue": "#4F7CAC",
      "neutral_bg": "#F6F1E7",
      "ink": "#1B1B1B",
      "muted": "#6B6B6B"
    },
    "typography": {
      "headline": "Fraunces, Georgia, serif",
      "body": "Inter, Helvetica, sans-serif",
      "mono": "JetBrains Mono, ui-monospace"
    },
    "created": "2026-04-26"
  },
  "items": {
    "des_01": {
      "section": "edt_01",
      "kind": "image",
      "data_source": null,
      "spec": {
        "alt": "Volunteer fixers at a community repair cafe working on broken household items",
        "caption": "A community repair cafe in session — volunteer fixers, neighbours' broken belongings, and the unglamorous tools of a circular economy.",
        "placement": "hero, full-bleed above title"
      },
      "file": "assets/hero_repair_cafe.png"
    },
    "des_02": {
      "section": "edt_02",
      "kind": "chart",
      "data_source": "ana_02",
      "spec": {
        "type": "donut",
        "title": "Outcome of 178,749 repair visits (2015-2026)",
        "subtitle": "63% of items walk out working again",
        "fields": {"category": "outcome", "value": "count"},
        "color_map": {"Fixed": "#2A6F62", "Partially fixed / end-of-life": "#D9844B", "Not fixed": "#B94B45"},
        "show_pct_labels": true
      },
      "file": null
    },
    "des_03": {
      "section": "edt_03",
      "kind": "chart",
      "data_source": "ana_04",
      "spec": {
        "type": "horizontal_bar",
        "title": "Fix rate by category",
        "subtitle": "Textiles 92%, screen electronics 46% — a 50-point gap",
        "fields": {"x": "fix_rate", "y": "category", "size": "total"},
        "sort": "fix_rate desc",
        "annotation": "Bar length encodes fix rate; bar opacity / tooltip encodes total visits.",
        "x_unit": "percent_fixed",
        "color": "#2A6F62"
      },
      "file": null
    },
    "des_04": {
      "section": "edt_03",
      "kind": "chart",
      "data_source": "ana_05",
      "spec": {
        "type": "diverging_bar",
        "title": "Easiest vs hardest products to fix",
        "subtitle": "Among products with 500+ visits",
        "fields": {"x": "fix_rate", "y": "product", "color": "group"},
        "groups": {"easiest": "#2A6F62", "hardest": "#B94B45"},
        "x_baseline": 50,
        "x_unit": "percent_fixed"
      },
      "file": null
    },
    "des_05": {
      "section": "edt_04",
      "kind": "chart",
      "data_source": "ana_06",
      "spec": {
        "type": "dual_axis_bar_line",
        "title": "Repair visits per year, with fix rate overlay (2017-2025)",
        "subtitle": "4.2x growth from 2019 to 2025; fix rate stays in a tight 60-66% band",
        "fields": {"x": "year", "y_bar": "visits", "y_line": "fix_rate"},
        "annotations": [
          {"year": 2020, "label": "COVID dip"},
          {"year": 2024, "label": "EU Right-to-Repair adopted (Apr 2024)"}
        ],
        "color_bar": "#2A6F62",
        "color_line": "#D9844B"
      },
      "file": null
    },
    "des_06": {
      "section": "edt_05",
      "kind": "chart",
      "data_source": "ana_07",
      "spec": {
        "type": "horizontal_bar",
        "title": "Why repairs fail",
        "subtitle": "Three of the top seven reasons are about spare parts (combined 34.1%)",
        "fields": {"x": "pct_of_failed", "y": "reason"},
        "sort": "pct_of_failed desc",
        "highlight_keywords": ["Spare parts"],
        "highlight_color": "#B94B45",
        "default_color": "#6B6B6B",
        "x_unit": "percent_of_failed_visits"
      },
      "file": null
    },
    "des_07": {
      "section": "edt_06",
      "kind": "chart",
      "data_source": "ana_11",
      "spec": {
        "type": "lollipop",
        "title": "Brand fix-rate spread (300+ visits)",
        "subtitle": "Bicycles and sewing machines fix; printers and TVs don't",
        "fields": {"x": "fix_rate", "y": "brand", "color": "group"},
        "groups": {"best": "#2A6F62", "mid": "#6B6B6B", "worst": "#B94B45"},
        "x_unit": "percent_fixed",
        "reference_line": {"value": 63, "label": "dataset average 63%"}
      },
      "file": null
    },
    "des_08": {
      "section": "edt_07",
      "kind": "chart",
      "data_source": "ana_08",
      "spec": {
        "type": "multi_line",
        "title": "Mentions in repair_info_source: YouTube vs GenAI vs manuals",
        "subtitle": "GenAI is rising fast — but YouTube still leads ~14:1 in 2025",
        "fields": {"x": "year", "y": "mentions", "series": ["youtube", "manual", "genai"]},
        "series_colors": {"youtube": "#B94B45", "manual": "#6B6B6B", "genai": "#4F7CAC"},
        "y_unit": "mentions"
      },
      "file": null
    },
    "des_09": {
      "section": "edt_07",
      "kind": "image",
      "data_source": null,
      "spec": {
        "alt": "Still life with a partly disassembled coffee maker, paper user manual, and a tablet showing a chat interface",
        "caption": "Two repair tutors on the same workbench: a paper manual and an LLM chat. The dataset suggests one is replacing the other slowly, not quickly.",
        "placement": "inline image preceding the GenAI vs YouTube chart"
      },
      "file": "assets/genai_vs_youtube.png"
    }
  }
}
