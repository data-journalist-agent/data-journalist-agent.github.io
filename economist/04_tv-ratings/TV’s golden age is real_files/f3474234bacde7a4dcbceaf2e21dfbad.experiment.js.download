nction () {\\nvar template = html;\\nvar insertedNotes = [];\\nvar modifiedButtons = [];\\n\\nfunction applyChanges(root) {\\nvar cards = root.querySelectorAll(\\\"section.index-module--card--XXYG3, #offers > section[role='region']\\\");\\ncards.forEach(function (card) {\\n\/\/ Find the CTA button robustly\\nvar btn = card.querySelector(\\n\\\"button.index-module--cta--nYeio, button[class*='index-module--cta'], button.ds-button.button[role='button']\\\"\\n);\\nif (!btn || !btn.offsetParent) return;\\n\\n\/\/ Update CTA label\\nvar desired = \\\"Restart my subscription\\\";\\nvar current = (btn.textContent || \\\"\\\").trim();\\nif (current !== desired) {\\nbtn.dataset.origText = current;\\nbtn.textContent = desired;\\nbtn.setAttribute(\\\"aria-label\\\", desired);\\nmodifiedButtons.push(btn);\\n}\\n\\n\/\/ Add the supporting note only once per card\\nif (!card.querySelector(\\\".restart-support-note\\\")) {\\nvar note = template.cloneNode(true);\\nbtn.insertAdjacentElement(\\\"afterend\\\", note);\\ninsertedNotes.push(note);\\n}\\n});\\n}\\n\\nutils.waitForElement(\\\"#offers\\\").then(function (offers) {\\napplyChanges(offers);\\n\\n\/\/ Optional: watch for dynamic rerenders within #offers\\nvar mo = new MutationObserver(function () {\\napplyChanges(offers);\\n});\\nmo.observe(offers, { childList: true, subtree: true });\\n\\nutils.remove = function () {\\ninsertedNotes.forEach(function (n) {\\nif (n && n.parentNode) n.parentNode.removeChild(n);\\n});\\ninsertedNotes = [];\\nmodifiedButtons.forEach(function (b) {\\nif (b && b.dataset && b.dataset.origText !== undefined) {\\nb.textContent = b.dataset.origText;\\nb.removeAttribute(\\\"aria-label\\\");\\ndelete b.dataset.origText;\\n}\\n});\\nmodifiedButtons = [];\\nmo.disconnect();\\n};\\n});\\n})();\"}}],\"value\":\"variant-2\"},\"variant-3\":{\"key\":\"variant-3\",\"payload\":[{\"action\":\"mutate\",\"data\":{\"mutations\":[{\"action\":\"append\",\"attribute\":\"style\",\"metadata\":{\"scope\":[\"42319ddb-5551-4bbd-ba4a-31aa83927f12\"],\"type\":\"padding\"},\"selector\":\".index-module--card--XXYG3:nth-child(1) > .ds-button\",\"value\":\";padding:9.6px 28.8px !important\"},{\"action\":\"append\",\"attribute\":\"style\",\"metadata\":{\"scope\":[\"42319ddb-5551-4bbd-ba4a-31aa83927f12\"],\"type\":\"padding\"},\"selector\":\".index-module--mobileFirst--6jxr- > .ds-button\",\"value\":\";padding:9.6px 28.8px !important\"},{\"action\":\"append\",\"attribute\":\"style\",\"metadata\":{\"scope\":[\"42319ddb-5551-4bbd-ba4a-31aa83927f12\"],\"type\":\"padding\"},\"selector\":\".index-module--card--XXYG3:nth-child(3) > .ds-button\",\"value\":\";padding:9.6px 28.8px !important\"}]}},{\"action\":\"inject\",\"data\":{\"css\":\"\/* Economist CTA: full-width + brand styling + subtle hover scale *\/\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio {\\ndisplay: block;\\nwidth: 100%;\\nbox-sizing: border-box;\\nbackground-color: #E3120B !important; \/* Economist red *\/\\nborder-color: #E3120B !important;\\ncolor: #ffffff !important;\\nfont-weight: 600;\\npadding: 14px 16px;\\nborder-radius: 4px;\\ntext-align: center;\\nwhite-space: normal; \/* allow wrap on small screens *\/\\ntransition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease, border-color 150ms ease;\\ntransform-origin: center center;\\n}\\n\\n\/* Hover\/active\/focus states *\/\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio:hover {\\ntransform: scale(1.02);\\nbackground-color: #C8110A !important;\\nborder-color: #C8110A !important;\\nbox-shadow: 0 6px 18px rgba(227, 18, 11, 0.25);\\n}\\n\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio:active {\\ntransform: scale(0.995);\\n}\\n\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio:focus-visible {\\noutline: none;\\nbox-shadow: 0 0 0 3px rgba(6, 31, 47, 0.28), 0 6px 18px rgba(227, 18, 11, 0.25); \/* subtle navy focus ring *\/\\n}\\n\\n\/* Respect users who prefer reduced motion *\/\\n@media (prefers-reduced-motion: reduce) {\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio,\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio:hover,\\n#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio:active {\\ntransition: none;\\ntransform: none;\\nbox-shadow: none;\\n}\\n}\",\"html\":\"<div id=\\\"ab-econ-cta-sentinel\\\" aria-hidden=\\\"true\\\" style=\\\"display:none\\\"><\/div>\",\"id\":\"ampexpd77653f0430a48bfbb12650177b8a0c0\",\"js\":\"(function () {\\nvar sentinel = html;\\n\\n\/\/ Helper to update CTA buttons consistently\\nfunction applyCTAUpdates(root) {\\nvar btns = (root || document).querySelectorAll('#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio');\\nbtns.forEach(function (btn) {\\n\/\/ Update label to requested copy\\nvar desired = 'Restart and save';\\nif (btn.textContent.trim() !== desired) {\\nbtn.textContent = desired;\\n}\\nbtn.setAttribute('aria-label', desired);\\nbtn.classList.add('ab-cta-fw'); \/\/ marker class (no styling dependency)\\n});\\n}\\n\\n\/\/ Initial apply once the offers render\\nutils.waitForElement('#limio-view-layout .index-module--card--XXYG3 button.index-module--cta--nYeio')\\n.then(function () {\\n\/\/ Keep a sentinel in DOM for SPA cleanup\\ndocument.body.appendChild(sentinel);\\n\\napplyCTAUpdates(document);\\n\\n\/\/ Observe re-renders (region change, plan toggles, etc.)\\nvar container = document.querySelector('#limio-view-layout');\\nif (!container) return;\\n\\nvar mo = new MutationObserver(function (mutations) {\\nvar needsUpdate = false;\\nfor (var i = 0; i < mutations.length; i++) {\\nvar m = mutations[i];\\nif (m.type === 'childList') {\\n\/\/ If any card or cta buttons are added, re-apply\\nif ([].some.call(m.addedNodes, function (n) {\\nreturn n.nodeType === 1 && (\\nn.matches?.('.index-module--card--XXYG3, button.index-module--cta--nYeio') ||\\nn.qu